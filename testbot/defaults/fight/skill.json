{
  "schema_version": 1,
  "description": "同一文件配置技能、属性被动、底层常量与出招触发器；新对局自动加载有效版本。",
  "constants": {
    "attack_per_stage": 1.18,
    "attribute_multiplier": 1.2,
    "damage_variance": 0.08,
    "defense_multiplier": 0.7,
    "vulnerability_multiplier": 1.4,
    "confusion_probability": 0.45,
    "bleed_damage": 55,
    "thorns_ratio": 0.3
  },
  "passives": [
    {
      "id": "normal_balance",
      "name": "普通·均衡",
      "when": {
        "eq": [
          {
            "var": "self.attribute"
          },
          "普通"
        ]
      },
      "modifiers": {
        "damage_multiplier": 1.08,
        "damage_taken_multiplier": 0.92
      }
    },
    {
      "id": "water_guard",
      "name": "水·水幕",
      "when": {
        "eq": [
          {
            "var": "self.attribute"
          },
          "水"
        ]
      },
      "modifiers": {
        "damage_taken_multiplier": 0.85
      }
    },
    {
      "id": "fire_attack",
      "name": "火系攻击+1",
      "when": {
        "eq": [
          {
            "var": "self.attribute"
          },
          "火"
        ]
      },
      "modifiers": {
        "attack": 1
      }
    },
    {
      "id": "grass_vitality",
      "name": "草·生息",
      "when": {
        "eq": [
          {
            "var": "self.attribute"
          },
          "草"
        ]
      },
      "modifiers": {
        "accuracy": 0.05
      }
    },
    {
      "id": "dark_power",
      "name": "暗·蓄势",
      "when": {
        "and": [
          {
            "eq": [
              {
                "var": "self.attribute"
              },
              "暗"
            ]
          },
          {
            "gt": [
              {
                "var": "self.hp"
              },
              {
                "mul": [
                  0.5,
                  {
                    "var": "self.max_hp"
                  }
                ]
              }
            ]
          }
        ]
      },
      "modifiers": {
        "damage_multiplier": 1.08
      }
    },
    {
      "id": "dark_desperation",
      "name": "暗·背水",
      "when": {
        "and": [
          {
            "eq": [
              {
                "var": "self.attribute"
              },
              "暗"
            ]
          },
          {
            "lte": [
              {
                "var": "self.hp"
              },
              {
                "mul": [
                  0.5,
                  {
                    "var": "self.max_hp"
                  }
                ]
              }
            ]
          }
        ]
      },
      "modifiers": {
        "damage_multiplier": 1.25
      }
    },
    {
      "id": "light_insight",
      "name": "光·明鉴",
      "when": {
        "eq": [
          {
            "var": "self.attribute"
          },
          "光"
        ]
      },
      "modifiers": {
        "accuracy": 0.15,
        "damage_taken_multiplier": 0.92
      }
    },
    {
      "id": "unknown_risk",
      "name": "？·命运骰",
      "when": {
        "eq": [
          {
            "var": "self.attribute"
          },
          "？"
        ]
      },
      "modifiers": {
        "damage_multiplier": {
          "add": [
            1,
            {
              "var": "self.vars.fate_delta"
            }
          ]
        }
      }
    },
    {
      "id": "light_glare_penalty",
      "name": "光·干扰",
      "when": {
        "gt": [
          {
            "var": "self.vars.light_glare"
          },
          0
        ]
      },
      "modifiers": {
        "accuracy": -0.15
      }
    }
  ],
  "triggers": [
    {
      "id": "action_flags",
      "event": "before_skill",
      "steps": [
        {
          "op": "set_var",
          "name": "fate_delta",
          "value": 0
        },
        {
          "op": "set_var",
          "name": "target_was_light",
          "value": {
            "eq": [
              {
                "var": "enemy.attribute"
              },
              "光"
            ]
          }
        }
      ]
    },
    {
      "id": "grass_recovery",
      "event": "before_skill",
      "when": {
        "and": [
          {
            "eq": [
              {
                "var": "self.attribute"
              },
              "草"
            ]
          },
          {
            "lt": [
              {
                "var": "self.hp"
              },
              {
                "var": "self.max_hp"
              }
            ]
          }
        ]
      },
      "steps": [
        {
          "op": "heal",
          "target": "self",
          "amount": 20,
          "cap_to_max": true
        }
      ]
    },
    {
      "id": "guard_reset",
      "event": "before_skill",
      "when": {
        "ne": [
          {
            "var": "skill.id"
          },
          0
        ]
      },
      "steps": [
        {
          "op": "set_var",
          "name": "last_guard",
          "value": 0
        }
      ]
    },
    {
      "id": "fate_roll",
      "event": "before_skill",
      "when": {
        "eq": [
          {
            "var": "self.attribute"
          },
          "？"
        ]
      },
      "steps": [
        {
          "op": "choose",
          "choices": [
            {
              "weight": 15,
              "steps": [
                {
                  "op": "set_var",
                  "name": "fate_delta",
                  "value": 0.5
                },
                {
                  "op": "message",
                  "text": "命运骰·大成功！本次普通技能伤害为150%。"
                }
              ]
            },
            {
              "weight": 70,
              "steps": [
                {
                  "op": "set_var",
                  "name": "fate_delta",
                  "value": 0
                },
                {
                  "op": "message",
                  "text": "命运骰·平常：本次普通技能伤害为100%。"
                }
              ]
            },
            {
              "weight": 15,
              "steps": [
                {
                  "op": "set_var",
                  "name": "fate_delta",
                  "value": -0.5
                },
                {
                  "op": "message",
                  "text": "命运骰·大失败！本次普通技能伤害只有50%。"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "action_expire",
      "event": "after_skill",
      "steps": [
        {
          "op": "set_var",
          "name": "fate_delta",
          "value": 0
        },
        {
          "op": "set_var",
          "name": "light_glare",
          "value": 0
        }
      ]
    },
    {
      "id": "light_dazzle",
      "event": "after_skill",
      "when": {
        "and": [
          {
            "var": "self.vars.target_was_light"
          },
          {
            "var": "action.hit"
          },
          {
            "gt": [
              {
                "var": "enemy.hp"
              },
              0
            ]
          },
          {
            "gt": [
              {
                "var": "self.hp"
              },
              0
            ]
          }
        ]
      },
      "steps": [
        {
          "op": "chance",
          "probability": 0.4,
          "then": [
            {
              "op": "set_var",
              "name": "light_glare",
              "value": 1
            },
            {
              "op": "message",
              "text": "光耀反制！攻击者下次出招命中降低15个百分点，不叠加。"
            }
          ]
        }
      ]
    }
  ],
